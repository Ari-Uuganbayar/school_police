{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(npm run lint *)",
      "Bash(npm run build *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx next build *)",
      "Bash(npx expo lint *)",
      "Bash(npx expo export *)",
      "Bash(npx expo-doctor *)",
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/alembic check *)",
      "Bash(.venv/bin/alembic current *)",
      "Bash(.venv/bin/alembic history *)",
      "Bash(curl -s http://localhost:8000/*)",
      "Bash(psql schoolpolice -c *)",
      "Bash(.venv/bin/ruff *)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./web/.env.local)",
      "Read(./mobile/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint.sh",
            "timeout": 60,
            "statusMessage": "Lint ажиллаж байна..."
          }
        ]
      }
    ]
  }
}
